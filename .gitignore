# ---------------------------------------------------------------------------
# Unexplored Workspace Navigation — ignore rules
#
# Rule of thumb: source, launch, config and docs are tracked. Anything a build
# or a robot run regenerates is not.
#
# To commit something these rules exclude (e.g. one small reference bag or a
# finished map you want to keep), force it:  git add -f <path>
# ---------------------------------------------------------------------------

# --- catkin / ROS build artifacts -------------------------------------------
# Regenerated by `catkin_make`; devel/ contains absolute paths to this NUC and
# would break on any other machine.
build/
devel/
install/
logs/
.catkin_workspace
.catkin_tools/
# Symlink catkin drops into src/ pointing at /opt/ros/noetic toplevel.cmake
uan_ws/src/CMakeLists.txt

# --- ROS runtime output ------------------------------------------------------
.ros/
*.bag
*.bag.active
*.bag.orig.*
# roslaunch / rosout logs
*.log
log/

# --- generated maps ----------------------------------------------------------
# gmapping/SLAM output. The .pgm is the occupancy image and its .yaml is just a
# pointer to it — both are run artifacts, not config.
maps/
*.pgm
*.pbstream

# --- recorded data & results -------------------------------------------------
# Odometry / cmd_vel traces and anything else a run spits out.
data/
results/
*.csv
*.npy
*.npz

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
# virtualenvs
venv/
.venv/
env/

# --- editors & IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.*.kate-swp

# --- OS noise ----------------------------------------------------------------
.DS_Store
Thumbs.db

# --- local-only settings -----------------------------------------------------
# Per-machine overrides that shouldn't follow the repo to another robot.
*.local
.env
