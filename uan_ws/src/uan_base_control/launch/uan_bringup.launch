<launch>
  <!--
    UAN bringup: starts the LoCoBot control stack with the mobile base enabled.

    This wraps interbotix_xslocobot_control/xslocobot_control.launch (from the
    system workspace at $INTERBOTIX_WS) so the whole project has one entry point.
    A copy of that launch file is kept in ../../../reference/ for reading only.
  -->

  <arg name="robot_model"   default="locobot_wx200"/>
  <arg name="robot_name"    default="locobot"/>
  <arg name="base_type"     default="$(optenv INTERBOTIX_XSLOCOBOT_BASE_TYPE create3)"/>
  <arg name="use_base"      default="true"/>
  <arg name="use_lidar"     default="false"/>
  <arg name="use_camera"    default="false"/>
  <arg name="use_rviz"      default="false"/>

  <include file="$(find interbotix_xslocobot_control)/launch/xslocobot_control.launch">
    <arg name="robot_model" value="$(arg robot_model)"/>
    <arg name="robot_name"  value="$(arg robot_name)"/>
    <arg name="base_type"   value="$(arg base_type)"/>
    <arg name="use_base"    value="$(arg use_base)"/>
    <arg name="use_lidar"   value="$(arg use_lidar)"/>
    <arg name="use_camera"  value="$(arg use_camera)"/>
    <arg name="use_rviz"    value="$(arg use_rviz)"/>
  </include>

</launch>
